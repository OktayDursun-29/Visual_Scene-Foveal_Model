{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup Python workspace",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\setup.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run target tracking demo",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\target_tracking_demo.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Run all tests",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "-p", "no:cacheprovider", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Run Gen.jl trajectory",
      "type": "process",
      "command": "julia",
      "args": ["${workspaceFolder}\\scripts\\GenJLModel.jl"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
